<%
const canon = page.canonical && page.canonical.startsWith('http') ? page.canonical : siteUrl + (page.canonical || '');
const faqLd = type ? { '@context':'https://schema.org','@type':'FAQPage','mainEntity': type.faqs.map(f=>({'@type':'Question','name':f[0],'acceptedAnswer':{'@type':'Answer','text':f[1]}})) } : null;
const appLd = { '@context':'https://schema.org','@type':'WebApplication','name': brand,'applicationCategory':'UtilitiesApplication','operatingSystem':'Any','offers':{'@type':'Offer','price':'0'},'description': page.desc };
const crumbLd = { '@context':'https://schema.org','@type':'BreadcrumbList','itemListElement': [{ '@type':'ListItem','position':1,'name':'Home','item': siteUrl + '/' }, type ? { '@type':'ListItem','position':2,'name': type.h1,'item': canon } : { '@type':'ListItem','position':2,'name':'Batch QR codes','item': canon }] };
const safe = (o) => JSON.stringify(o).replace(/</g, '\\u003c'); // blocks </script> break-out
const jsonld = `<script type="application/ld+json">${safe(appLd)}</script>` + (faqLd ? `<script type="application/ld+json">${safe(faqLd)}</script>` : '') + `<script type="application/ld+json">${safe(crumbLd)}</script>`;
const hasGenerator = true;
%>
<%- include('partials/head', { jsonld }) %>

<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <span><%= type ? type.h1 : 'Batch QR codes' %></span></nav>
<section class="hero">
  <h1><%= page.h1 %></h1>
  <p class="sub"><%= page.desc %></p>
  <ul class="badges" aria-label="Trust badges"><li data-i18n="freeForever">✓ Free forever</li><li data-i18n="noSignup">✓ No sign-up</li><li data-i18n="noWatermark">✓ No watermark</li></ul>
</section>

<%- include('partials/generator') %>

<% if (type) { %>
<section class="section"><div class="section-head"><h2><%= type.icon %> <%= type.h1 %></h2></div><p><%= type.intro %></p><p><%= type.intro2 %></p><p><%= type.why %></p>
<h3>How to create one</h3><ol class="steps"><% type.steps.forEach(s => { %><li><%= s %></li><% }) %></ol></section>
<section class="section"><div class="section-head"><h2>Real-life uses</h2></div><div class="grid"><% type.uses.forEach(u => { %><div class="glass"><strong><%= u[0] %></strong><p><%= u[1] %></p></div><% }) %></div></section>
<section class="section"><div class="section-head"><h2>Tips for best scanning</h2></div><ul class="tips"><% type.tips.forEach(t => { %><li><%= t %></li><% }) %></ul></section>
<section class="section" id="typefaq"><div class="section-head"><h2>FAQ</h2></div><% type.faqs.forEach((f,i) => { %><details class="glass" <%= i===0?'open':'' %>><summary><%= f[0] %></summary><p><%= f[1] %></p></details><% }) %></section>
<% } %>
<section class="section"><div class="section-head"><h2>Related QR types</h2></div><div class="grid"><% related.forEach(r => { %><div class="glass"><a href="/<%= r.slug %>"><strong><%= r.icon %> <%= r.label %> QR</strong></a><p>Create &amp; download free.</p></div><% }) %></div></section>

<%- include('partials/foot', { hasGenerator }) %>
