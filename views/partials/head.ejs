<!DOCTYPE html>
<html lang="en" dir="ltr" data-theme="auto">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= page.title %></title>
<meta name="description" content="<%= page.desc %>">
<meta name="keywords" content="<%= (typeof type !== 'undefined' && type && type.keyword ? type.keyword + ', ' : '') %>free qr code generator, qr code maker, generate qr code online, free qr codes no watermark, wifi qr code, vcard qr code, svg qr code, batch qr code generator, high resolution qr code, print ready qr code, no signup qr code">
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
<meta name="author" content="Bishal Aryal">
<meta name="application-name" content="<%= brand %>">
<meta name="apple-mobile-web-app-title" content="<%= brand %>">
<meta name="theme-color" content="#4f46e5">
<link rel="canonical" href="<%= page.canonical && page.canonical.startsWith('http') ? page.canonical : siteUrl + (page.canonical || '') %>">

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= brand %>">
<meta property="og:locale" content="en_US">
<meta property="og:title" content="<%= page.title %>">
<meta property="og:description" content="<%= page.desc %>">
<meta property="og:url" content="<%= page.canonical && page.canonical.startsWith('http') ? page.canonical : siteUrl + (page.canonical || '') %>">
<meta property="og:image" content="<%= siteUrl %>/og-cover.png">
<meta property="og:image:secure_url" content="<%= siteUrl %>/og-cover.png">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="<%= page.title %>">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= page.title %>">
<meta name="twitter:description" content="<%= page.desc %>">
<meta name="twitter:image" content="<%= siteUrl %>/og-cover.png">
<meta name="twitter:image:alt" content="<%= page.title %>">

<link rel="icon" href="/icons.svg">
<link rel="apple-touch-icon" href="/icon-192.png">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="stylesheet" href="/css/styles<%= min %>.css">
<%- typeof jsonld !== 'undefined' ? jsonld : '' %>
<% if (typeof analyticsSrc !== 'undefined' && analyticsSrc) { %><script src="<%= analyticsSrc %>" defer></script><% } %>
</head>
<body>
<a class="skip" href="#generator">Skip to generator</a>
<div class="navwrap">
  <nav class="navbar" aria-label="Main">
    <a class="logo" href="/" aria-label="<%= brand %> home"><span class="logo-mark" aria-hidden="true"></span><span class="logo-text"><%= brand %></span></a>
    <button id="navToggle" class="icon-btn nav-toggle" aria-expanded="false" aria-controls="navLinks" aria-label="Open menu">☰</button>
    <div class="nav-links" id="navLinks">
      <a href="/#generator" data-i18n="generator">Generator</a>
      <a href="/#features" data-i18n="features">Features</a>
      <a href="/#faq" data-i18n="faq">FAQ</a>
      <a href="/about" data-i18n="about">About</a>
    </div>
    <div class="langwrap">
      <button id="langBtn" class="langbtn" aria-expanded="false" aria-haspopup="true" aria-controls="langMenu" aria-label="Language: English" title="Language"><span class="flag fl-en" id="langFlag" aria-hidden="true"></span><span class="chev" aria-hidden="true">▾</span></button>
      <div class="langmenu glass" id="langMenu" role="menu" hidden>
        <button role="menuitemradio" aria-checked="true" data-lang="en"><span class="flag fl-en" aria-hidden="true"></span>English</button>
        <button role="menuitemradio" aria-checked="false" data-lang="zh"><span class="flag fl-zh" aria-hidden="true"></span>中文 (简体)</button>
        <button role="menuitemradio" aria-checked="false" data-lang="es"><span class="flag fl-es" aria-hidden="true"></span>Español</button>
        <button role="menuitemradio" aria-checked="false" data-lang="ja"><span class="flag fl-ja" aria-hidden="true"></span>日本語</button>
        <button role="menuitemradio" aria-checked="false" data-lang="pt"><span class="flag fl-pt" aria-hidden="true"></span>Português</button>
        <button role="menuitemradio" aria-checked="false" data-lang="ko"><span class="flag fl-ko" aria-hidden="true"></span>한국어</button>
        <button role="menuitemradio" aria-checked="false" data-lang="ru"><span class="flag fl-ru" aria-hidden="true"></span>Русский</button>
        <button role="menuitemradio" aria-checked="false" data-lang="ne"><span class="flag fl-ne" aria-hidden="true"></span>नेपाली</button>
        <button role="menuitemradio" aria-checked="false" data-lang="hi"><span class="flag fl-hi" aria-hidden="true"></span>हिन्दी</button>
        <button role="menuitemradio" aria-checked="false" data-lang="ar"><span class="flag fl-ar" aria-hidden="true"></span>العربية</button>
      </div>
    </div>
    <button id="themeBtn" class="icon-btn" aria-label="Toggle dark mode" aria-pressed="false">◐</button>
  </nav>
</div>
<main><div class="wrap">
