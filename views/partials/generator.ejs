<% /* Shared generator card — home, type and batch pages. Needs: page, fieldDefs. */ %>
<section class="card glass tool modern-tool" id="generator" aria-label="QR generator" data-pagetype="<%= page.type %>" data-batch="<%= page.batch ? 1 : 0 %>">
  <!-- Studio Header -->
  <div class="tool-head">
    <div class="tool-title-wrap">
      <span class="tool-badge"><span class="badge-spark" aria-hidden="true">✨</span> Studio Workspace</span>
      <h2 class="tool-title">Interactive QR Code Generator</h2>
      <p class="tool-sub">Real-time vector engine • 100% browser-based • Free high-res exports</p>
    </div>
    <div class="tool-meta">
      <p class="live-pill" id="livePill"><span class="pulse" aria-hidden="true"></span>Live Engine Active</p>
    </div>
  </div>

  <!-- Type Selector Navigation -->
  <div class="tabs-wrapper">
    <div class="tabs" role="tablist" aria-label="QR types" id="tabs"></div>
  </div>

  <% if (page.batch) { %>
  <!-- Batch Mode Box -->
  <div class="batchbox modern-card">
    <div class="batch-head">
      <span class="batch-badge">📦 Batch Studio</span>
      <h3>Generate Multiple QR Codes (List or CSV → ZIP)</h3>
      <p>Paste multiple items (one per line) or upload a CSV file. Each row generates a high-res PNG bundled into a single ZIP archive — generated completely in your browser.</p>
    </div>
    <div class="batch-body">
      <div class="field">
        <label for="batchInput">Items to encode (one per line)
          <textarea id="batchInput" rows="5" placeholder="https://example.com/page-1&#10;https://example.com/page-2&#10;https://example.com/page-3"></textarea>
        </label>
      </div>
      <div class="row2">
        <div class="field">
          <label for="batchFile">Or upload CSV / TXT file
            <input type="file" id="batchFile" accept=".csv,.txt">
          </label>
        </div>
        <div class="field">
          <label for="batchType">Batch QR Type
            <select id="batchType">
              <option value="url">Website (URL)</option>
              <option value="text">Plain Text</option>
              <option value="wifi">WiFi Network</option>
              <option value="phone">Phone Number</option>
              <option value="sms">SMS Message</option>
            </select>
          </label>
        </div>
      </div>
      <button id="batchGo" class="btn-batch">⚡ Generate &amp; Download ZIP Archive</button>
      <p class="status" id="batchStatus" role="status" aria-live="polite"></p>
    </div>
  </div>
  <% } %>

  <div class="gen-grid">
    <!-- Left Column: Content Form & Appearance Settings -->
    <div class="form-col">
      <!-- Step 01: Content Form -->
      <div class="panel-section content-panel">
        <div class="panel-header">
          <span class="step-num">01</span>
          <div>
            <h3>Enter Content</h3>
            <p>Fill out the details below — the live QR code updates instantly.</p>
          </div>
        </div>
        <form id="typeForm" novalidate></form>
      </div>

      <!-- Step 02: Style & Quality Settings -->
      <div class="panel-section style-panel">
        <div class="panel-header">
          <span class="step-num">02</span>
          <div>
            <h3>Style &amp; Customization</h3>
            <p>Customize shapes, colors, margins, and center logo.</p>
          </div>
        </div>

        <fieldset class="stylebox">
          <legend class="vh">Style &amp; quality</legend>

          <!-- Shapes & Error Correction -->
          <div class="style-group">
            <h4 class="style-group-title">Shapes &amp; Quality</h4>
            <div class="row2">
              <div class="field">
                <label for="modStyle">Module Pattern
                  <select id="modStyle">
                    <option value="square">Standard Square</option>
                    <option value="rounded">Smooth Rounded</option>
                    <option value="dots">Modern Dots</option>
                  </select>
                </label>
              </div>
              <div class="field">
                <label for="eyeStyle">Corner Eye Style
                  <select id="eyeStyle">
                    <option value="square">Square</option>
                    <option value="rounded">Rounded</option>
                    <option value="circle">Circular</option>
                  </select>
                </label>
              </div>
            </div>

            <div class="row2">
              <div class="field">
                <label for="quality">Download Quality
                  <select id="quality">
                    <option value="512">Standard · 512px</option>
                    <option value="1024" selected>High Definition · 1024px</option>
                    <option value="2048">Ultra HD · 2048px</option>
                    <option value="4096">Print Master · 4096px</option>
                  </select>
                </label>
              </div>
              <div class="field">
                <label for="eclevel">Error Correction Level
                  <select id="eclevel">
                    <option value="L">Level L — Smallest (7%)</option>
                    <option value="M" selected>Level M — Balanced (15%)</option>
                    <option value="Q">Level Q — Sturdy (25%)</option>
                    <option value="H">Level H — Maximum (30%)</option>
                  </select>
                </label>
              </div>
            </div>
            <p class="hint">Higher correction increases density but ensures scannability if smudged or damaged.</p>
          </div>

          <!-- Color Customization & Presets -->
          <div class="style-group">
            <h4 class="style-group-title">Color Palette</h4>
            <div class="color-presets" aria-label="Quick color presets">
              <span class="presets-label">Presets:</span>
              <button type="button" class="preset-chip" onclick="document.getElementById('fg').value='#0f172a';document.getElementById('bg').value='#ffffff';document.getElementById('grad').checked=false;document.getElementById('fg').dispatchEvent(new Event('input'));">⚫ Classic</button>
              <button type="button" class="preset-chip" onclick="document.getElementById('fg').value='#4f46e5';document.getElementById('bg').value='#ffffff';document.getElementById('grad').checked=false;document.getElementById('fg').dispatchEvent(new Event('input'));">🟣 Indigo</button>
              <button type="button" class="preset-chip" onclick="document.getElementById('fg').value='#0284c7';document.getElementById('bg').value='#ffffff';document.getElementById('grad').checked=false;document.getElementById('fg').dispatchEvent(new Event('input'));">🔵 Sky</button>
              <button type="button" class="preset-chip" onclick="document.getElementById('fg').value='#059669';document.getElementById('bg').value='#ffffff';document.getElementById('grad').checked=false;document.getElementById('fg').dispatchEvent(new Event('input'));">🟢 Emerald</button>
              <button type="button" class="preset-chip" onclick="document.getElementById('fg').value='#4f46e5';document.getElementById('grad').checked=true;document.getElementById('fg2').value='#06b6d4';document.getElementById('bg').value='#ffffff';document.getElementById('fg').dispatchEvent(new Event('input'));">🌈 Dual Grad</button>
            </div>

            <div class="row2">
              <div class="field color-field">
                <label for="fg">Code Color
                  <div class="color-picker-wrapper">
                    <input type="color" id="fg" value="#111111">
                    <span class="color-tag">Foreground</span>
                  </div>
                </label>
              </div>
              <div class="field color-field">
                <label for="bg">Background Color
                  <div class="color-picker-wrapper">
                    <input type="color" id="bg" value="#ffffff">
                    <span class="color-tag">Backdrop</span>
                  </div>
                </label>
              </div>
            </div>

            <div class="toggles-row">
              <label class="toggle-card">
                <input type="checkbox" id="grad">
                <span class="toggle-text">Gradient Color:</span>
                <input type="color" id="fg2" value="#4f46e5">
              </label>

              <label class="toggle-card">
                <input type="checkbox" id="transparent">
                <span class="toggle-text">Transparent Background (PNG &amp; SVG)</span>
              </label>
            </div>

            <p class="warn" id="contrastWarn" hidden>⚠ Low contrast detected — cameras may struggle to read. Keep the code much darker than the background.</p>
          </div>

          <!-- Margin & Brand Logo -->
          <div class="style-group">
            <h4 class="style-group-title">Quiet Zone &amp; Brand Logo</h4>
            <div class="field range-field">
              <div class="range-header">
                <label for="margin">Quiet Zone Margin</label>
                <span class="range-badge" id="marginVal">4</span>
              </div>
              <input type="range" id="margin" min="0" max="10" value="4">
            </div>

            <div class="row2">
              <div class="field logo-upload-field">
                <label for="logo">Center Brand Logo (≤2MB)
                  <input type="file" id="logo" accept="image/png,image/jpeg,image/svg+xml">
                </label>
              </div>
              <div class="field range-field">
                <div class="range-header">
                  <label for="logoSize">Logo Size</label>
                  <span class="range-badge" id="logoVal">20%</span>
                </div>
                <input type="range" id="logoSize" min="15" max="22" value="20">
              </div>
            </div>

            <!-- Scannability Diagnostic Indicator -->
            <div class="scan-bar" id="scanRow" hidden>
              <div class="scan-left">
                <span class="scan-indicator-dot" id="scanDot" aria-hidden="true"></span>
                <span class="scan-title">Scannability Meter:</span>
              </div>
              <span class="scan-desc" id="scanText"></span>
            </div>
          </div>
        </fieldset>

        <!-- Saved History Gallery -->
        <details class="hist modern-details">
          <summary data-i18n="recent">
            <span class="summary-left">🕘 Recent Saved Codes (Local to this browser)</span>
          </summary>
          <div class="details-body">
            <div id="histList"></div>
            <button type="button" id="clearHist" class="btn-clear" data-i18n="clearHist">Clear History</button>
          </div>
        </details>
      </div>
    </div>

    <!-- Right Column: Interactive Canvas Showcase & Downloads -->
    <div class="prev-col">
      <div class="panel-section preview-panel">
        <div class="panel-header">
          <span class="step-num">03</span>
          <div>
            <h3>Live Preview &amp; Export</h3>
            <p>Inspect or download in multiple high-res formats.</p>
          </div>
        </div>

        <div class="preview-card-wrap">
          <div class="canvas-glass-frame">
            <div class="canvas-bar-top">
              <div class="canvas-status-tag">
                <span class="canvas-dot"></span> Live Vector Engine
              </div>
              <span class="canvas-dim-tag">560 × 560 Preview</span>
            </div>

            <div class="preview" id="previewWrap">
              <canvas id="preview" width="560" height="560" role="img" aria-label="QR code preview"></canvas>
              <div class="empty" id="emptyState">
                <div class="empty-icon">⚡</div>
                <p>Enter details on the left — your QR code appears here instantly.</p>
              </div>
            </div>

            <p class="dl-hint" data-i18n="dlHint">Choose your export format below ↓</p>
          </div>

          <div class="canvas-meta">
            <p class="reassure" data-i18n="reassure">🔒 100% Client-side. No sign-up. Never leaves your browser.</p>
            <p class="status" id="status" role="status" aria-live="polite"></p>
          </div>

          <!-- Primary Download Grid -->
          <div class="dl-section">
            <div class="dl-bar">
              <button data-dl="png" class="btn-dl btn-dl-png" disabled>
                <span class="dl-icon">🖼️</span>
                <span class="dl-text"><b>PNG</b><small>High Res</small></span>
              </button>
              <button data-dl="svg" class="btn-dl btn-dl-svg" disabled>
                <span class="dl-icon">📐</span>
                <span class="dl-text"><b>SVG</b><small>Vector</small></span>
              </button>
              <button data-dl="pdf" class="btn-dl btn-dl-pdf" disabled>
                <span class="dl-icon">📄</span>
                <span class="dl-text"><b>PDF</b><small>Print Ready</small></span>
              </button>
              <button data-dl="jpg" class="btn-dl btn-dl-jpg" disabled>
                <span class="dl-icon">🌄</span>
                <span class="dl-text"><b>JPG</b><small>Compact</small></span>
              </button>
            </div>

            <!-- Secondary Action Buttons -->
            <div class="dl-bar2">
              <button id="copyBtn" class="btn-action" disabled data-i18n="copy">📋 Copy Image</button>
              <button id="printBtn" class="btn-action" disabled data-i18n="print">🖨️ Quick Print</button>
              <button id="tentBtn" class="btn-action btn-tent" disabled hidden data-i18n="tent">⛺ Table Tent A4</button>
            </div>
          </div>

          <!-- Quality Verification Checklist -->
          <details class="verify glass modern-details">
            <summary data-i18n="verifyTitle">
              <span class="summary-left">✓ Pre-Print Quality Checklist</span>
            </summary>
            <div class="details-body">
              <ol class="checklist">
                <li><label><input type="checkbox" class="vchk"> <span data-i18n="v1">Print at 2cm or larger with adequate quiet margin</span></label></li>
                <li><label><input type="checkbox" class="vchk"> <span data-i18n="v2">Test-scan with both an iPhone and an Android camera</span></label></li>
                <li><label><input type="checkbox" class="vchk"> <span data-i18n="v3">Confirm the destination link or details open correctly</span></label></li>
              </ol>
              <p class="vok" hidden data-i18n="vok">✓ Verified — ready for mass printing.</p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</section>
<script id="fieldDefs" type="application/json"><%- JSON.stringify(fieldDefs).replace(/</g, '\\u003c') %></script>
