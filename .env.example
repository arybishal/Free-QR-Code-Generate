# Copy to .env and adjust. Placeholders to replace: [DOMAIN], [CONTACT EMAIL], [COUNTRY]
PORT=3000
SITE_URL=https://[DOMAIN]
BRAND_NAME=QRNova
CONTACT_EMAIL=[CONTACT EMAIL]
COUNTRY=[COUNTRY]
# 1 = serve minified CSS/JS (after `npm run build`). Static export always uses minified.
USE_MIN=0
# Optional privacy-friendly analytics script URL. Empty = zero third-party requests.
ANALYTICS_SRC=
